{# VARLENYX section wrapper — MBO §7/§9 universal page skeleton.
   Extracted from the repeating block that used to live inline in
   layouts/_page-body.njk, so every content section (on any layout) renders
   through one shared component instead of duplicated markup.
   Params: section = {eyebrow, heading, body, theme ("light"|undefined),
                       cards: [{tag, title, summary, url, linkLabel}]} #}
<section class="section {% if section.theme == 'light' %}theme-light{% endif %}"
  style="{% if section.theme == 'light' %}background:var(--color-paper); color:var(--color-text-dark);{% endif %}">
  <div class="container">
    {% if section.eyebrow %}<p class="eyebrow">{{ section.eyebrow }}</p>{% endif %}
    {% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
    {% if section.body %}<p>{{ section.body }}</p>{% endif %}

    {% if section.cards %}
    <div class="grid" style="margin-top: var(--space-6);">
      {% for card in section.cards %}
      <div style="grid-column: span 4;">
        {% include "card.njk" %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
